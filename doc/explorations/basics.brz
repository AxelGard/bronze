/* ------------------------------------------------------------------
    19. match

    `if` is a statement, so this needs a tidy way to branch on a value.
    Suggested: match as a statement, every case must be covered.
    Alternatives:
      B. match as an expression (produces a value)
      C. switch / case like C
------------------------------------------------------------------ */

func label(s: Status) -> String
{
    match s
    {
        Status.Pending   => return "waiting"
        Status.Paid      => return "paid"
        Status.Shipped   => return "on its way"
        Status.Cancelled => return "cancelled"
    }
}


func size(n: Int) -> String
{
    match n
    {
        0          => return "none"
        1..=9      => return "a few"
        10..=99    => return "many"
        _          => return "lots"        // _ = anything else
    }
}

// CHOICE: B 



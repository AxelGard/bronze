    OPERATORS AND EQUALITY
================================================================== */

/* ------------------------------------------------------------------
    11. Compound assignment

    Suggested: += -= *= /= %=
    Alternatives:
      B. None, always write x = x + 1
      C. Also ++ and --
------------------------------------------------------------------ */

mut count = 0
count += 1
count *= 10

// CHOICE: yes! 


/* ------------------------------------------------------------------
    12. == on classes

    Suggested: classes compare by identity (same object).
               data classes compare by value (already decided).
    Alternatives:
      B. Classes can define their own equals()
      C. Separate operators: == for value, === for identity
------------------------------------------------------------------ */

class Account { mut balance = 0 }
data Money(amount: Int, currency: String)

con a1 = Account()
con a2 = Account()
print(a1 == a2)                         // false: different accounts
print(a1 == a1)                         // true: same account

print(Money(5, "EUR") == Money(5, "EUR"))   // true: same value

// CHOICE: I think it might be good that classes compare idenity but im not sure. 


/* ------------------------------------------------------------------
    13. Operator precedence (highest first)

        1. ()  .  []  calls
        2. not  -x
        3. *  /  %
        4. +  -
        5. ..  ..=
        6. ==  !=  <  <=  >  >=  is
        7. and
        8. or
        9. else   (error handling)
------------------------------------------------------------------ */

con ok = not done and count > 3 or forced
// means:  ((not done) and (count > 3)) or forced


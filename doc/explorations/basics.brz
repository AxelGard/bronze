    Alternatives:
      B. Test functions in separate *_test.brz files (Go)
------------------------------------------------------------------ */

func add(a: Int, b: Int) -> Int
{
    return a + b
}

test "add works"
{
    assert(add(2, 2) == 4)
    assert(add(-1, 1) == 0)
}


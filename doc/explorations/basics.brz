/* ------------------------------------------------------------------
    F1. Int = Int64 or Int32?

    Suggested: Int64. Backend code is full of ids, byte counts and
    timestamps. Int32 stops at about 2.1 billion; a timestamp in
    milliseconds is already about 1.7 trillion.
    (And Float = Float64.)
------------------------------------------------------------------ */

con user_id: Int = 4_000_000_000        // fits in Int64, not in Int32
con now_ms: Int = 1_731_600_000_000     // fits in Int64, not in Int32

// CHOICE: Int == Int64, and yes also add Float64


/* ------------------------------------------------------------------
    F2. Mixing Int and Float

    You wrote: Int / Float == Float.
    That conflicts with "an Int is never silently turned into a Float".

      A. Mixed arithmetic is allowed, the result is a Float
      B. Keep it explicit: convert yourself
------------------------------------------------------------------ */

con half_a = 7 / 2.0                    // A: 3.5
con half_b = Float(7) / 2.0             // B: 3.5, and `7 / 2.0` is a compile error

// CHOICE: con half_b = Float(7) / 2.0             // B: 3.5, and `7 / 2.0` is a compile error


/* ------------------------------------------------------------------
    F3. Division by zero

    Suggested: Int division by zero panics (like Go). Float gives inf.
    Division by zero is almost always a bug, and making every `/`
    handle a possible failure would be very noisy.
      B. Division can fail:  10 / x else 0
------------------------------------------------------------------ */

con x = 0
con a = 10 / x                          // suggested: panic: division by zero
con b = 10 / x else 0                   // B: every division needs handling

// CHOICE: okay panic 


/* ------------------------------------------------------------------
    F4. Indexing returns T?

    You chose B. That's safe, but every index needs handling.
    Loops with `for n in nums` are not affected.

      B.  nums[0] is Int?              (your choice)
      C.  nums[0] panics if missing, nums.get(0) is Int?
------------------------------------------------------------------ */

con first = nums[0] ?? 0                // B
con last = word[-1] ?? ""               // B

con first_c = nums[0]                   // C: Int, panics if empty
con maybe_c = nums.get(0)               // C: Int?

// CHOICE: I do wonder if it should not be nums[0] else 0


/* ------------------------------------------------------------------
    F5. Slicing syntax

      A. Python style:   s[2:5]   s[:3]   s[2:]
      B. Reuse ranges:   s[2..5]  s[..3]  s[2..]   and   s[2..=5]
------------------------------------------------------------------ */

con part_a = word[2:5]                  // A
con part_b = word[2..5]                 // B
con part_c = word[2..=5]                // B: including index 5

// CHOICE: I think B 


/* ------------------------------------------------------------------
    F6. Mixing and / or

    `not done and count > 3 or forced` means:
        ok is true if `forced`,
        or if (not `done` and `count > 3`).
    `and` binds tighter than `or`, like `*` binds tighter than `+`.

    Since that's easy to misread: should the formatter / LSP suggest
    parentheses when `and` and `or` are mixed?
------------------------------------------------------------------ */

con ok = (not done and count > 3) or forced     // clearer with parentheses

// CHOICE: yes add parentheses


/* ------------------------------------------------------------------
    F7. Enums "of different types"

      A. Each case has a value of one type
      B. Each case carries its own data (sum types)
      C. Both
    (Methods on enums: recorded as yes.)
------------------------------------------------------------------ */

enum Role: String                       // A
{
    Admin = "admin"
    Member = "member"

    func can_delete() -> Bool
    {
        return this == Role.Admin
    }
}

enum Shape                              // B
{
    Circle(radius: Float)
    Rect(w: Float, h: Float)

    func area() -> Float
    {
        return match this
        {
            Circle(r)  => 3.14 * r * r
            Rect(w, h) => w * h
        }
    }
}


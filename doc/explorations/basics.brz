/* ------------------------------------------------------------------
    22. Panics and assert

    A panic stops the program with a message and a stack trace
    pointing at Bronze lines.
------------------------------------------------------------------ */

func checked_age(age: Int) -> Int
{
    assert(age >= 0, "age can't be negative")
    if age > 150
    {
        panic("unrealistic age: {age}")
    }
    return age
}

//   panic: unrealistic age: 200
//     at checked_age (src/users.brz:12)
//     at main        (src/main.brz:5)

// CHOICE: yes


/* ------------------------------------------------------------------
    23. Tests


/* ==================================================================
    NUMBERS
================================================================== */

/* ------------------------------------------------------------------
    1. Size of Int and Float

    Suggested: Int is 64-bit, Float is 64-bit.
    Alternatives:
      B. Also sized types: Int8, Int16, Int32, UInt8 ... Float32
      C. Int is unlimited (big integers, like Python). Slower.
------------------------------------------------------------------ */

con big = 9_223_372_036_854_775_807     // largest Int
con pi = 3.141592653589793              // Float

// CHOICE: B, and yes I also want sized types, but I think I want Int32 == Int, I want Int to just be an ailas for Int32 or 64 based on what we talk about. 


/* ------------------------------------------------------------------
    2. Integer overflow

    Suggested: panic (crash with a clear message). Catches bugs.
    Alternatives:
      B. Wrap around silently (Go, C, Java)
      C. Panic by default, plus explicit wrapping operations: a.wrapping_add(b)
------------------------------------------------------------------ */

con too_big = big + 1                   // panic: integer overflow at basics.brz:38

// CHOICE: I think B 


/* ------------------------------------------------------------------
    3. Integer division

    Suggested: Int / Int gives an Int (rounded toward zero).
    Alternatives:
      B. Int / Int gives a Float (Python 3), and // for integer division
------------------------------------------------------------------ */

print(7 / 2)                            // 3
print(-7 / 2)                           // -3
print(7 % 2)                            // 1
print(Float(7) / 2.0)                   // 3.5

// CHOICE: Int / Int == Int, but Int / Float == Float 


/* ------------------------------------------------------------------
    4. Division by zero

    Suggested: Int division by zero panics. Float gives inf / NaN (IEEE standard).
    Alternatives:
      B. Division can fail: 10 / x else 0
------------------------------------------------------------------ */

con zero = 0
con boom = 10 / zero                    // panic: division by zero
con inf = 1.0 / 0.0                     // inf

// CHOICE: Im not sure 


/* ------------------------------------------------------------------
    5. Number literals
------------------------------------------------------------------ */

con million = 1_000_000                 // underscores for readability
con mask = 0xFF                         // hex
con flags = 0b1010                      // binary
con perms = 0o755                       // octal
con small = 1.5e-3                      // scientific

// CHOICE: yes!


/* ------------------------------------------------------------------
    6. Bytes

    Backend code needs raw bytes: files, HTTP bodies, hashing, images.
    Suggested: a Byte type (0-255) and Bytes (a list of bytes).
------------------------------------------------------------------ */

con b: Byte = 0x41
con logo: Bytes = file.read_bytes("logo.png") else panic("missing logo")
con hash = sha256(logo)
con text = logo.to_string() else ""     // decoding can fail (not valid UTF-8)

// CHOICE: yes, type Bytes makes since to me! 



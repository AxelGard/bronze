/* ------------------------------------------------------------------
    8. Escapes
------------------------------------------------------------------ */

print("line one\nline two")             // newline
print("tab\there")                      // tab
print("she said \"hi\"")                // quote
print("a literal \{ brace")             // { without interpolation
print("back\\slash")                    // backslash

// CHOICE: yes 


/* ------------------------------------------------------------------
    9. Multi-line strings

    Suggested: triple quotes. Leading indentation is removed.
    Very handy for SQL.
------------------------------------------------------------------ */

con query = """
    select id, email
    from users
    where active = true
      and created_at > $1
    """

// CHOICE: yes! 


/* ------------------------------------------------------------------
    10. Length and characters

    Suggested: strings are UTF-8. length() counts characters, not bytes.
------------------------------------------------------------------ */

con word = "smörgåsbord"
print(word.length())                    // 11 characters
print(word.byte_length())               // 13 bytes
print(word[0])                          // "s"
print(word.upper())                     // "SMÖRGÅSBORD"


/* ------------------------------------------------------------------
    15. Indexing

    Suggested: list[i] panics when out of range.
               map[key] returns T? (the key may be missing).
    Alternatives:
      B. list[i] returns T? too (safe, but noisy)
      C. list[i] panics, list.get(i) returns T?
------------------------------------------------------------------ */

print(nums[0])                          // 1
print(nums[10])                         // panic: index 10 out of range (length 3)

con ada = ages["Ada"]                   // Int?
con zed = ages["Zed"] ?? 0              // 0

// CHOICE: I think option B


/* ------------------------------------------------------------------
    16. for loops and ranges

    Suggested:
      for x in list
      for i, x in list          (index first, like Go)
      for k, v in map
      for i in 0..10            (0 to 9)
      for i in 0..=10           (0 to 10)
------------------------------------------------------------------ */

for n in nums
{
    print(n)
}

for i, n in nums
{
    print("{i}: {n}")
}

for name, age in ages
{
    print("{name} is {age}")
}

for i in 0..10
{
    print(i)
}

// CHOICE: looks good! 


/* ------------------------------------------------------------------
    17. break and continue
------------------------------------------------------------------ */

for n in nums
{
    if n == 2
    {
        continue
    }
    if n > 10
    {
        break
    }
    print(n)
}

// CHOICE: yes! 



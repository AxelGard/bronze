func main() -> Int
{
    con args = os.args()                          // List<String>, without the program name
    con port = env.get("PORT") else "8080"        // env.get can fail: not set

    if args.length() == 0
    {
        print("usage: myapp <name>")
        return 1
    }

    print("hello {args[0]}, listening on {port}")
    return 0
}


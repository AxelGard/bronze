/* ------------------------------------------------------------------
    21. Top-level constants and globals

    Suggested: `con` allowed at the top level. Top-level `mut` is not
    allowed (shared global state is a common source of bugs, and of
    problems once requests run at the same time).
------------------------------------------------------------------ */

con MAX_USERS = 1000
con API_VERSION = "v2"


func squre_evens(x: int32): int32, Error
    if x % 2 == 0:
        return x ** 2, null
    return 0, Error.Value_Error 




// a intrface is a contract that the a given object will contain this atributes and methods 
interface I_Person 
{
    func talk(message: str): str // just a signature no decleration of implmention 
}

class Person inherits [I_Person] 
{
    
}

enum Error
    not = null
    value_error = 1

enum Error: int
{
    non = 0,
    value_error = 1,
}

Error(0) == Error.non
0 == int(Error.non)
0 != Error.non


func main(): int
    const pi = 3.14
    mut x = (1 + 2) * 3 - -4
    print(x)
    return 0


func main(): int32 
{
    x: mut<int32> = (1 + 2) * 3 - -4
    pi: con<float32> = 3.14
    print(x)
    return 0
}



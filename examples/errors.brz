/*
    errors.brz: errors as values, with the `else` shortcut          [decided]

    The idea:
      - An error is a normal value. It is RETURNED, never thrown.
      - `-> User ! DbError` means: returns a User, or fails with a DbError.
      - The caller must deal with it, using `else`:

            find_user(id) else return                  pass the error up
            find_user(id) else return 404              return something else instead
            find_user(id) else (e) return Wrap(e)      pass it up, wrapped
            find_user(id) else User(0, "guest")        use a fallback value
            find_user(id) else (e) { ... }             full block
            find_user(id) else continue / break        skip in a loop
            find_user(id) else panic("...")            crash: this must not fail

      - For full control, the Go form still works:

            con user, err = find_user(id)
            if err != null { ... }
*/


/* ------------------------------------------------------------------
    1. Declaring errors

    An error is any class or data class that `use`s Error.
    Inheritance groups them.
------------------------------------------------------------------ */

class DbError use Error { }

data NotFound(id: Int) use DbError
data ConnectionLost() use DbError

data ConfigError(message: String, cause: Error?) use Error


/* ------------------------------------------------------------------
    2. Returning an error

    Return either the value or the error. No dummy values.
------------------------------------------------------------------ */

func find_user(id: Int) -> User ! DbError
{
    if id <= 0
    {
        return NotFound(id)
    }

    return User(id, "ada@example.com")
}


/* ------------------------------------------------------------------
    3. Passing an error up: `else return`
------------------------------------------------------------------ */

func get_email(id: Int) -> String ! DbError
{
    con user = find_user(id) else return
    return user.email
}


/* Several in a row stays short and readable */
func send_welcome(id: Int) -> ! Error
{
    con user = find_user(id) else return
    con body = render("welcome.html", user) else return
    mail.send(user.email, "Welcome!", body) else return
}


/* ------------------------------------------------------------------
    4. Adding context: `else (e) return ...`
------------------------------------------------------------------ */

func load_port(path: String) -> Int ! ConfigError
{
    con text = read_file(path) else (e) return ConfigError("could not read {path}", e)
    con port = Int.parse(text) else (e) return ConfigError("{path} is not a number", e)

    if port < 1 or port > 65535
    {
        return ConfigError("port {port} out of range", null)
    }

    return port
}


/* ------------------------------------------------------------------
    5. Fallback values: `else <value>`
------------------------------------------------------------------ */

func display_name(id: Int) -> String
{
    con user = find_user(id) else User(0, "guest")
    return user.email
}


func timeout_seconds() -> Int
{
    con text = env.get("TIMEOUT") else "30"
    return Int.parse(text) else 30
}


/* ------------------------------------------------------------------
    6. Handling it here: `else (e) { ... }`

    The block must leave: return, break, continue else panic.
------------------------------------------------------------------ */

func status_for(id: Int) -> Int
{
    con user = find_user(id) else (e)
    {
        if e is NotFound
        {
            return 404
        }

        log.error("database problem: {e.message}")
        return 503
    }

    return 200
}


/* ------------------------------------------------------------------
    7. The Go form, for full control

    Useful when you want to keep the error around as a value.
------------------------------------------------------------------ */

func check_many(ids: List<Int>) -> List<DbError>
{
    mut errors: List<DbError> = []

    for id in ids
    {
        con user, err = find_user(id)
        if err != null
        {
            errors.add(err)
        }
    }

    return errors
}


/* ------------------------------------------------------------------
    8. Loops: `else continue`, `else break`
------------------------------------------------------------------ */

func emails(ids: List<Int>) -> List<String>
{
    mut out: List<String> = []

    for id in ids
    {
        con user = find_user(id) else continue     /* skip users that fail */
        out.add(user.email)
    }

    return out
}


func first_valid_port(lines: List<String>) -> Int?
{
    for line in lines
    {
        con port = Int.parse(line) else continue
        return port
    }

    return null
}


/* ------------------------------------------------------------------
    9. Functions that return nothing but can fail: `-> ! Error`
------------------------------------------------------------------ */

func save(user: User) -> ! DbError
{
    db.exec("insert into users (id, email) values ($1, $2)", user.id, user.email) else return
}


func register(email: String) -> ! Error
{
    con user = User(0, email)
    save(user) else return
    log.info("registered {email}")
}


/* ------------------------------------------------------------------
    10. Startup code: `else panic`

    When there is no sensible way to continue.
------------------------------------------------------------------ */

func connect() -> db.Connection
{
    con url = env.get("DATABASE_URL") else panic("DATABASE_URL is not set")
    return db.connect(url) else (e) panic("could not connect: {e.message}")
}


/* ------------------------------------------------------------------
    11. Errors and null together

    `User? ! DbError`: the query may fail, and if it works it may find nothing.
    `else` handles the error, `??` and `if` handle the null.
------------------------------------------------------------------ */

func find_by_email(email: String) -> User? ! DbError
{
    con row = db.query_one("select id, email from users where email = $1", email) else return

    if row == null
    {
        return null
    }

    return User(row.int("id"), row.string("email"))
}


func greeting(email: String) -> String
{
    con user = find_by_email(email) else return "error"
    if user == null
    {
        return "who are you?"
    }

    return "hello {user.email}"
}


/* ------------------------------------------------------------------
    12. A full HTTP handler
------------------------------------------------------------------ */

func get_user(req: http.Request) -> http.Response
{
    con id = Int.parse(req.param("id")) else return http.bad_request("id must be a number")

    con user = find_user(id) else (e)
    {
        if e is NotFound
        {
            return http.not_found()
        }
        return http.server_error()
    }

    return http.ok(json.encode(user))
}


func main() -> Int
{
    con port = load_port("config/port.txt") else (e)
    {
        print("bad config: {e.message}")
        return 1
    }

    con server = http.Server()
    server.get("/users/{id}", get_user)
    server.listen(port) else return 1

    return 0
}


/* ------------------------------------------------------------------
    13. Two kinds of else, never in the same place

    `if` is a statement, so its `else` always comes after a closing `}`.
    The error `else` always comes right after an expression.
    And `or` stays plain logical or.
------------------------------------------------------------------ */

func is_admin(id: Int) -> Bool ! DbError
{
    con user = find_user(id) else return
    return user.email.ends_with("@admin.com")
}


func can_delete(id: Int, is_owner: Bool) -> Bool
{
    con admin = is_admin(id) else false   /* error else: false if the lookup fails */

    if admin or is_owner                  /* logical or */
    {
        return true
    }
    else                                  /* if else: after the closing brace */
    {
        return false
    }
}


/*
    Open questions:
      - Should `else` also replace `??` for null?   find_email(id) else "unknown"
      - Can an `else (e) { }` block produce a fallback value, or must it always leave?
      - Is `-> ! Error` the right way to write "returns nothing, can fail"?
      - Should a mixed line like `is_admin(id) else false` give a hint in the editor?
*/

from "web" import html, Http, Requst
from "sqlite" import SQL_Client

mut http = Http.app() 

const db = SQL_Client() 


func new_user(username:String, password:String): int
{
    global db
    const uuid = crypto.UUID()
    const hashed_password = crypto.password_hash(password)
    return db.sql("""
    INSERT INTO users(id, username, password)
    VALUES (uuid, username, hashed_password); 
    """, uuid, username,hashed_password)
}

@http.route("/")
func home(): html
{
    return "<h1> Hello web!</h1>"
}


@http.post("/login")
func login_post(req: Request)
{
    global db
    req.payload["username"]
}




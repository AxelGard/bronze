func is_palindrome(s: String) -> Bool
{
    con n = s.length()
    for i in 0..n / 2
    {
        if s[i] != s[n - 1 - i]
        {
            return false
        }
    }
    return true
}

func main() -> Int
{
    // slices of a list are new lists, and never fail
    con xs = [1, 2, 3, 4, 5]
    print(xs[1..3])
    print(xs[1..=3])
    print(xs[..2])
    print(xs[3..])
    print(xs[-2..])
    print(xs[..-1])
    print(xs[1..100])
    print(xs[5..])
    print(xs[4..1])
    con all = xs[..]
    all.append(6)
    print(xs.length())
    print(all.length())

    // strings count characters, not bytes
    con s = "héllo wörld"
    print(s.length())
    print(s[1] else "?")
    print(s[-1] else "?")
    print(s[99] == null)
    print(s[1..5])
    print(s[6..])
    print(s.index_of("wö") else -1)

    // methods
    print("a,b,,c".split(","))
    print("abc".split(""))
    print("[" + "  hi \n".trim() + "]")
    print("Ada".to_upper() + " " + "ADA".to_lower())
    print("banana".replace("an", "AN"))
    print("bronze".starts_with("br"))
    print("bronze".ends_with("ze"))
    print("bronze".contains("on"))
    print("bronze".index_of("x") == null)

    // for over a String gives one-character Strings
    mut reversed = ""
    for c in "stressed"
    {
        reversed = c + reversed
    }
    print(reversed)
    for i, c in "ab"
    {
        print(String(i) + c)
    }
    print(is_palindrome("racecar"))
    print(is_palindrome("bronze"))
    return 0
}

func is_prime(n: Int) -> Bool
{
    if n < 2
    {
        return false
    }
    for d in 2..n
    {
        if d * d > n
        {
            break
        }
        if n % d == 0
        {
            return false
        }
    }
    return true
}

func main() -> Int
{
    // `..` leaves out the end, `..=` includes it
    mut sum = 0
    for i in 0..5
    {
        sum += i
    }
    print(sum)
    for i in 1..=3
    {
        print(i)
    }

    // `_` ignores the value
    mut stars = ""
    for _ in 0..4
    {
        stars += "*"
    }
    print(stars)

    // an empty range: ranges only count up
    for i in 5..2
    {
        print("never")
    }

    // the bounds are evaluated once
    mut n = 3
    for i in 0..n
    {
        n += 1
    }
    print(n)

    // outside a for, a range is a List<Int>
    con evens = 0..4
    for i, x in evens
    {
        print(i * 100 + x * 2)
    }

    for p in 1..=30
    {
        if is_prime(p)
        {
            print(p)
        }
    }

    // ranges near the largest Int
    for i in 9223372036854775806..=9223372036854775807
    {
        print(i)
    }
    return 0
}

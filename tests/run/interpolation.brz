enum Status
{
    Active
    Frozen
}

func main() -> Int
{
    con name = "Ada"
    con nums = [1, 2, 3]
    con ages = {"Ada": 36}
    print("{name} is {36 + 1}")
    print("first: {nums[0] else 0}, last: {nums[-1] else 0}")
    print("age: {ages["Ada"] else 0}")
    print("nested: {"<{name}>"}")
    print("{nums} {ages} {Status.Frozen} {1.5} {true}")
    print("braces: \{ and } stay")
    print("{name}{name}")
    print("{nums.length()} items, {name.to_upper()}")
    mut line = ""
    for i in 1..=3
    {
        line += "{i}."
    }
    print(line)
    return 0
}

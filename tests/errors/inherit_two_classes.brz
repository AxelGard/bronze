class Animal
{
    con name = ""

    func init(name: String)
    {
        this.name = name
    }

    func speak() -> String
    {
        return "..."
    }
}

class Plant
{
}

class Weird use Animal, Plant
{
    func init()
    {
        super(Animal).init("weird")
    }
}

func main() -> Int
{
    return 0
}

class Animal
{
    con name = ""

    func init(name: String)
    {
        this.name = name
    }

    func speak() -> String
    {
        return "..."
    }
}

class Dog use Animal
{
    func init()
    {
        super(Animal).init("dog")
    }

    func speak() -> String
    {
        return "Woof"
    }
}

func main() -> Int
{
    return 0
}

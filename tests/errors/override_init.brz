class Animal
{
    con name = ""

    func init(name: String)
    {
        this.name = name
    }

    func speak() -> String
    {
        return "..."
    }
}

class Dog use Animal
{
    override func init(name: String)
    {
        super(Animal).init(name)
    }
}

func main() -> Int
{
    return 0
}
